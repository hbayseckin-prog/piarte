# Piarte Kurs Yönetim Sistemi - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Veritabanı Bağlantısı
# PostgreSQL için:
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/piarte_db

# SQLite için (sadece geliştirme):
# DATABASE_URL=sqlite:///./data.db

# Session Secret Key (MUTLAKA DEĞİŞTİRİN!)
# Güvenli bir rastgele string oluşturun (en az 32 karakter)
SECRET_KEY=değiştirin-bu-çok-güvenli-bir-anahtar-olmalı-en-az-32-karakter-rastgele

# Root Path (eğer uygulama alt dizinde çalışacaksa, örn: /piarte)
ROOT_PATH=

# Sunucu Ayarları
HOST=0.0.0.0
PORT=8000

# CORS Origins (Production için belirli domain'ler belirtin)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Web Push (opsiyonel — yoksa sunucu ilk açılışta DB'de üretir)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Apple iOS için gerçek e-posta veya site URL'si kullanın (@localhost / @*.local çalışmaz)
# VAPID_CLAIM_EMAIL=mailto:sizin@emailiniz.com
# veya: PUBLIC_BASE_URL=https://your-app.up.railway.app













